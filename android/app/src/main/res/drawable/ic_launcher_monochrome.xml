<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour version of the icon. Android 13+ tints it to match the user's wallpaper theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glass rim -->
    <path
        android:pathData="M54,26 A28,28 0 1 1 54,82 A28,28 0 1 1 54,26 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4" />

    <!-- Crosshair ticks -->
    <path
        android:pathData="M54,30 L54,39 M54,69 L54,78 M30,54 L39,54 M69,54 L78,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- Lens ring -->
    <path
        android:pathData="M54,39 A15,15 0 1 1 54,69 A15,15 0 1 1 54,39 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4" />

    <!-- Centre dot -->
    <path
        android:pathData="M54,49 A5,5 0 1 1 54,59 A5,5 0 1 1 54,49 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
