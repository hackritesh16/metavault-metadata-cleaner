<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a glass lens with the MetaVault ring and crosshair.
     Everything sits inside the 66dp centre safe zone so no launcher mask can crop it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft shadow under the glass -->
    <path android:pathData="M54,25 A34,34 0 1 1 54,93 A34,34 0 1 1 54,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="59"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#66000000" />
                <item android:offset="0.72" android:color="#4D000000" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass disc: translucent fill with a bright rim along the top edge -->
    <path android:pathData="M54,26 A28,28 0 1 1 54,82 A28,28 0 1 1 54,26 Z"
        android:strokeWidth="1.6">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="82">
                <item android:offset="0" android:color="#40FFFFFF" />
                <item android:offset="1" android:color="#0DFFFFFF" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="82">
                <item android:offset="0" android:color="#CCFFFFFF" />
                <item android:offset="1" android:color="#1AFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight glint on the upper left of the glass -->
    <path
        android:pathData="M30.9,43.2 A25.5,25.5 0 0 1 43.2,30.9"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- Crosshair ticks -->
    <path
        android:pathData="M54,30 L54,39 M54,69 L54,78 M30,54 L39,54 M69,54 L78,54"
        android:strokeColor="#F2F5FB"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- Lens ring -->
    <path android:pathData="M54,39 A15,15 0 1 1 54,69 A15,15 0 1 1 54,39 Z"
        android:strokeWidth="3.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="39"
                android:startY="39"
                android:endX="69"
                android:endY="69">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFA9C0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mint glow behind the centre dot -->
    <path android:pathData="M54,43 A11,11 0 1 1 54,65 A11,11 0 1 1 54,43 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="11">
                <item android:offset="0" android:color="#803DDC97" />
                <item android:offset="1" android:color="#003DDC97" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Centre dot -->
    <path android:pathData="M54,49 A5,5 0 1 1 54,59 A5,5 0 1 1 54,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="49"
                android:endX="54"
                android:endY="59">
                <item android:offset="0" android:color="#FF9BF3CE" />
                <item android:offset="1" android:color="#FF3DDC97" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
